---
const title = 'Juan de la Fuente Costa — Security Engineering';
const description =
  'Security engineering, application security, cyber threat intelligence, and automation. Building practical security capabilities that help teams make better decisions.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f7f4" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <style>
      :root {
        color-scheme: light;
        --background: #f7f7f4;
        --surface: #ffffff;
        --text: #202421;
        --muted: #626963;
        --border: #dedfd8;
        --accent: #3659d9;
        --max-width: 1120px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family:
          Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 15.5px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      a:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      .container {
        width: min(var(--max-width), calc(100% - 48px));
        margin-inline: auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: var(--background);
        border-bottom: 1px solid var(--border);
      }

      .navigation {
        min-height: 84px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
      }

      .wordmark {
        display: inline-flex;
        flex-direction: column;
        text-decoration: none;
        line-height: 1.3;
      }

      .wordmark strong {
        font-size: 0.96rem;
        font-weight: 750;
        letter-spacing: -0.025em;
      }

      .wordmark span {
        margin-top: 4px;
        color: var(--muted);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .nav-links a {
        color: var(--muted);
        font-size: 0.88rem;
        text-decoration: none;
        transition: color 150ms ease;
      }

      .nav-links a:hover {
        color: var(--accent);
      }

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.8fr) minmax(0, 0.5fr);
  align-items: center;
  gap: clamp(20px, 2.5vw, 32px);
  padding-block: clamp(28px, 4vw, 48px) 80px;
}

      .hero-content {
        min-width: 0;
      }

.hero-visual {
  min-width: 0;
  width: 100%;
  max-width: 260px;
  justify-self: end;
}

.hero-visual img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 28px;
        color: var(--accent);
        font-size: 0.76rem;
        font-weight: 750;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        width: 25px;
        height: 2px;
        background: currentColor;
        content: "";
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

h1 {
  width: 100%;
  max-width: 1040px;
  margin-bottom: 30px;
  font-size: clamp(2rem, 3.8vw, 3.6rem);
  font-weight: 650;
  letter-spacing: -0.035em;
  line-height: 1.08;
  text-wrap: balance;
}

      .hero h1 span {
        color: var(--accent);
      }

.hero-copy {
  max-width: 880px;
  margin-bottom: 34px;
  color: var(--muted);
  font-size: clamp(0.95rem, 1.05vw, 1.05rem);
  line-height: 1.8;
}

      .text-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text);
        font-size: 0.96rem;
        font-weight: 700;
        text-decoration-thickness: 1px;
        text-underline-offset: 5px;
        text-decoration-color: var(--accent);
      }

      .text-link:hover {
        color: var(--accent);
      }

      .section {
        padding-block: 50px;
        border-top: 1px solid var(--border);
      }

      .section-heading {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 48px;
        margin-bottom: 54px;
      }

      .section-label {
        margin-bottom: 14px;
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 750;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h2 {
        margin-bottom: 0;
        font-size: clamp(1.9rem, 3.5vw, 2.8rem);
        font-weight: 650;
        letter-spacing: -0.06em;
        line-height: 1.12;
      }

      .section-intro {
        max-width: 590px;
        align-self: end;
        margin-bottom: 0;
        color: var(--muted);
        font-size: 0.96rem;
      }

      .expertise-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .expertise-card {
        min-height: 245px;
        padding: 28px;
        border: 1px solid var(--border);
        background: rgb(255 255 255 / 48%);
      }

      .card-number {
        display: block;
        margin-bottom: 32px;
        color: var(--accent);
        font-size: 0.78rem;
        font-weight: 750;
      }

      h3 {
        margin-bottom: 12px;
        font-size: 1.12rem;
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.35;
      }

      .expertise-card p {
        margin-bottom: 0;
        color: var(--muted);
        font-size: 0.92rem;
      }

      .work-type {
        margin-bottom: 10px;
        color: var(--accent);
        font-size: 0.73rem;
        font-weight: 750;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .work-details {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
      }

      .work-details p + p {
        margin-top: 0;
      }

      .about-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 48px;
      }

      .about-copy {
        max-width: 680px;
        color: var(--muted);
      }

      .about-copy p {
        margin-bottom: 20px;
      }

      .about-copy p:last-child {
        margin-bottom: 0;
      }

      .principles {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-top: 58px;
      }

      .principle {
        padding-top: 18px;
        border-top: 2px solid var(--text);
      }

      .principle strong {
        display: block;
        margin-bottom: 8px;
        font-size: 1rem;
      }

      .principle span {
        color: var(--muted);
        font-size: 0.9rem;
      }

      .contact {
      }

      .contact-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 40px;
      }

      .contact h2 {
        max-width: 690px;
        margin-bottom: 22px;
      }

      .contact p {
        max-width: 580px;
        margin-bottom: 0;
        color: var(--muted);
      }

      .contact-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 50px;
        padding: 0 20px;
        background: var(--accent);
        color: #ffffff;
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: background 150ms ease;
      }

      .contact-link:hover {
        background: #2846b5;
      }

      .contact-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 12px 24px;
      }

      .contact-links a {
        color: var(--text);
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration-color: var(--accent);
        text-underline-offset: 5px;
      }

      .contact-links a:hover {
        color: var(--accent);
      }

      .site-footer {
        padding-block: 24px;
        border-top: 1px solid var(--border);
      }

      .footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .footer-content p {
        margin: 0;
        color: var(--muted);
        font-size: 0.8rem;
      }

      .footer-content a {
        font-size: 0.85rem;
        text-decoration-color: var(--border);
        text-underline-offset: 4px;
      }

      @media (max-width: 760px) {
        h1 {
          max-width: 100%;
          font-size: clamp(2.1rem, 8vw, 2.8rem);
          line-height: 1.1;
        }

        html {
          scroll-padding-top: 145px;
        }

        .container {
          width: min(100% - 36px, var(--max-width));
        }

        .navigation {
          min-height: 76px;
          align-items: flex-start;
          flex-direction: column;
          justify-content: center;
          gap: 14px;
          padding-block: 18px;
        }

        .nav-links {
          width: 100%;
          flex-wrap: wrap;
          gap: 10px 22px;
        }

        .hero {
          grid-template-columns: minmax(0, 1fr);
          gap: 32px;
          padding-block: 32px 56px;
        }
	
	.section,
        .contact {
          padding-block: 75px;
        }

        .section-heading,
        .about-grid,
        .contact-content {
          grid-template-columns: 1fr;
          gap: 22px;
        }

        .section-heading {
          margin-bottom: 35px;
        }

        .expertise-grid,
        .principles {
          grid-template-columns: 1fr;
        }

        .expertise-card {
          min-height: auto;
        }

        .card-number {
          margin-bottom: 22px;
        }

        .principles {
          gap: 28px;
          margin-top: 40px;
        }

        .contact-links {
          justify-content: flex-start;
          gap: 16px 22px;
        }
      }

	@media (min-width: 761px) and (max-width: 900px) {
      .hero {
        grid-template-columns: minmax(0, 1fr);
        gap: 32px;
      }

      .hero-visual {
        max-width: 620px;
      }
    }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }
      }
	.section-intro,
	.expertise-card p,
	.work-details p {
	  text-align: justify;
	}

    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="container navigation">
        <a class="wordmark" href="#top" aria-label="Juan de la Fuente Costa, home">
          <strong>Juan de la Fuente Costa</strong>
          <span>Security Engineering</span>
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="#expertise">Expertise</a>
          <a href="/articles/">Articles</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top">
	<section class="container hero" aria-labelledby="hero-title">
	  <div class="hero-content">
	    <p class="eyebrow">
	      Application Security · Threat Intelligence · Automation
	    </p>
	
	    <h1 id="hero-title">
	      Security engineering that turns complex problems into&nbsp;<span>actionable decisions.</span>
	    </h1>
	
	    <p class="hero-copy">
	      I'm Juan, a security engineer focused on building practical
	      capabilities that help teams understand risk, make better decisions,
	      and integrate security into the way they build software.
	    </p>
	  </div>
	
	  <div class="hero-visual">
	<img src="/images/security-engineering-overview.png"
  		alt="Abstract representation of security engineering, automation, and connected security capabilities"
	/>  
	</div>
	</section>

      <section class="section" id="expertise" aria-labelledby="expertise-title">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="section-label">01 / Expertise</p>
              <h2 id="expertise-title">Security built around real work.</h2>
            </div>

            <p class="section-intro">
              I work across security engineering, intelligence, and
              automation—with a focus on making security useful, understandable,
              and easier to apply in day-to-day engineering.
            </p>
          </div>

          <div class="expertise-grid">
            <article class="expertise-card">
              <span class="card-number">01</span>
              <h3>Application Security</h3>
              <p>
                Threat modeling, security design reviews, vulnerability
                management, and security integration throughout the software
                development lifecycle.
              </p>
            </article>

            <article class="expertise-card">
              <span class="card-number">02</span>
              <h3>Security Automation & AI</h3>
              <p>
                Turning repeatable security decisions into practical workflows
                that connect tools, surface useful context, and reduce friction
                for engineering teams.
              </p>
            </article>

            <article class="expertise-card">
              <span class="card-number">03</span>
              <h3>Cyber Threat Intelligence</h3>
              <p>
                Building intelligence capabilities that connect data
                collection, enrichment, analysis, and investigation to
                operational security needs.
              </p>
            </article>
          </div>
        </div>
      </section>
	<section class="section" id="about" aria-labelledby="about-title">
        <div class="container">
          <div class="about-grid">
            <div>
              <p class="section-label">02 / About</p>
              <h2 id="about-title">Technical depth, with an eye on outcomes.</h2>
            </div>

            <div class="about-copy">
              <p>
                My experience spans hands-on security engineering and the
                development of threat intelligence capabilities. That
                combination has shaped how I approach security problems:
                understand the operational need, build the right technical
                capability, and make the result useful to the people who rely
                on it.
              </p>

              <p>
                I enjoy working at the intersection of security, software
                engineering, data, and automation—especially when a complex
                process can be made clearer, more consistent, or easier to
                scale.
              </p>

              <p>
                I believe good security engineering is not just about finding
                problems. It is about helping people understand what matters
                and what they can do about it.
              </p>
            </div>
          </div>

          <div class="principles">

            <div class="principle">
              <strong>Action over noise</strong>
              <span>Security findings should help people decide what to do.</span>
            </div>

            <div class="principle">
              <strong>Integration over friction</strong>
              <span>Security works better when it fits the way teams work.</span>
            </div>

            <div class="principle">
              <strong>Intelligence over volume</strong>
              <span>More data is not necessarily better information.</span>
            </div>
          </div>

        </div>
      </section>

      <section class="section" id="contact" aria-labelledby="contact-title">
        <div class="container">
          <div class="about-grid">
          <div>
            <p class="section-label">03 / Contact</p>
            <h2 id="contact-title">Let's talk about building better security capabilities.</h2>
	</div>
            <div class="about-copy">
	    <p>
              I'm interested in thoughtful conversations about application
              security, threat intelligence, automation, and the practical use
              of AI in security engineering.
            </p>

          <div class="contact-links" aria-label="Find me online">
            <a href="https://www.linkedin.com/in/juan-de-la-fuente-costa"
               target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href="https://twitter.com/jdelafuente"
               target="_blank" rel="noopener noreferrer">X ↗</a>
            <a href="https://github.com/juandelafuente"
               target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
        </div>
        </div>
      </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-content">
        <p>© {new Date().getFullYear()} Juan de la Fuente Costa</p>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>
